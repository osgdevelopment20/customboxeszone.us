#--------------------------------------------------------------------------
# Google Indexing API (bulk search index requests)
#--------------------------------------------------------------------------
# Leave empty to use storage/app/google/indexing-service-account.json
GOOGLE_INDEXING_CREDENTIALS=
# Alternatively paste the key as raw or base64 encoded JSON:
GOOGLE_INDEXING_CREDENTIALS_JSON=
GOOGLE_INDEXING_DAILY_QUOTA=200
GOOGLE_INDEXING_BATCH_SIZE=100
GOOGLE_INDEXING_RESUBMIT_AFTER_DAYS=7
GOOGLE_INDEXING_USE_BATCH=true
GOOGLE_INDEXING_TIMEOUT=60
# Comma separated hosts that may be submitted (defaults to the APP_URL host).
GOOGLE_INDEXING_ALLOWED_HOSTS=
# Comma separated remote sitemap URLs to read URLs from.
GOOGLE_INDEXING_SITEMAP_URLS=
# Daily automatic submission through the Laravel scheduler.
GOOGLE_INDEXING_SCHEDULE=false
GOOGLE_INDEXING_SCHEDULE_TIME=03:00
GOOGLE_INDEXING_SCHEDULE_SOURCE=database
GOOGLE_INDEXING_SCHEDULE_SINCE_DAYS=2
GOOGLE_INDEXING_SCHEDULE_LIMIT=200

#--------------------------------------------------------------------------
# Deploy endpoint
#--------------------------------------------------------------------------
DEPLOY_SECRET=
# owner/repo (or a full URL). Set this so the deploy works even when the
# server checkout has no "origin" remote configured.
DEPLOY_GITHUB_REPOSITORY=osgdevelopment20/customboxeszone.us
DEPLOY_GITHUB_USERNAME=
DEPLOY_GITHUB_TOKEN=
DEPLOY_GIT_REMOTE=origin
DEPLOY_GIT_BRANCH=main
# Clear compiled config/routes/views after a successful pull.
DEPLOY_CLEAR_CACHE=true
DEPLOY_TIMEOUT=300
